@page "/admin/kpis"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "Admin")]
@using Microsoft.AspNetCore.Identity
@using QuoteTrack.Application.DTOs
@using QuoteTrack.Application.Interfaces
@using QuoteTrack.Domain.Entities
@inject IKpiReportService KpiReportService
@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>KPI Reports</PageTitle>

<style>
    .kpi-shell {
        max-width: 1380px;
        margin: 0 auto;
    }

    .kpi-toolbar {
        display: grid;
        grid-template-columns: minmax(220px, 1.4fr) 150px 150px minmax(230px, 1fr) 180px auto;
        gap: 12px;
        align-items: end;
        margin-bottom: 18px;
    }

    .kpi-report-grid {
        width: 100%;
        border-collapse: collapse;
        background: #fff;
        font-size: 13px;
    }

    .kpi-report-grid th {
        background: #1f4e79;
        color: #fff;
        padding: 9px;
        border: 1px solid #8ca6bd;
        font-weight: 800;
    }

    .kpi-report-grid td {
        border: 1px solid #b5b5b5;
        padding: 8px;
        vertical-align: top;
    }

    .kpi-code {
        width: 170px;
        background: #e9e9e9;
        font-weight: 800;
    }

    .kpi-metric {
        width: 220px;
        background: #f2f2f2;
        font-weight: 700;
    }

    .kpi-input {
        background: #fff2cc;
        min-width: 280px;
    }

    .kpi-auto {
        background: #d9eaf7;
        min-width: 320px;
    }

    .kpi-input textarea {
        min-height: 72px;
        resize: vertical;
    }

    .kpi-summary textarea {
        min-height: 110px;
        background: #fff2cc;
    }

    .kpi-period-pill {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 7px 10px;
        border: 1px solid #b8d5ea;
        background: #eef7fd;
        color: #1f4e79;
        font-weight: 800;
        border-radius: 6px;
    }

    @@media (max-width: 900px) {
        .kpi-toolbar {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="kpi-shell">
    <div class="d-flex justify-content-between align-items-start mb-3">
        <div>
            <h2 class="mb-1"><i class="bi bi-clipboard2-data text-success me-2"></i>KPI Reports</h2>
            <div class="text-muted">Weekly operational KPIs and monthly management KPIs with CRM-backed auto evidence.</div>
        </div>

        @if (report != null)
        {
            <span class="kpi-period-pill">
                <i class="bi bi-calendar-range"></i>
                @report.PeriodLabel
            </span>
        }
    </div>

    <div class="kpi-toolbar">
        <div>
            <label class="form-label fw-bold">Employee</label>
            <select class="form-select" @bind="selectedEmployeeId">
                @foreach (var user in users)
                {
                    <option value="@user.Id">@DisplayName(user)</option>
                }
            </select>
        </div>

        <div>
            <label class="form-label fw-bold">Template</label>
            <select class="form-select" @bind="templateCode">
                <option value="ELV 01">ELV 01</option>
                <option value="ELV 02">ELV 02</option>
                <option value="Sales 01">Sales 01</option>
            </select>
        </div>

        <div>
            <label class="form-label fw-bold">Report Type</label>
            <select class="form-select" @bind="reportType" @bind:after="RefreshPeriodOptions">
                <option value="Weekly">Weekly</option>
                <option value="Monthly">Monthly</option>
            </select>
        </div>

        <div>
            <label class="form-label fw-bold">Past Period</label>
            <select class="form-select" value="@selectedPeriodValue" @onchange="SelectPeriod">
                @foreach (var period in periodOptions)
                {
                    <option value="@period.Value">@period.Label</option>
                }
                <option value="custom">Custom date</option>
            </select>
        </div>

        <div>
            <label class="form-label fw-bold">Custom Date</label>
            <InputDate class="form-control" @bind-Value="periodAnchor" />
        </div>

        <div class="d-flex gap-2">
            <button class="btn btn-primary fw-bold" @onclick="LoadReportAsync" disabled="@isLoading">
                <i class="bi bi-arrow-clockwise me-1"></i> Generate
            </button>
            <button class="btn btn-success fw-bold" @onclick="SaveReportAsync" disabled="@(isLoading || report == null)">
                <i class="bi bi-save me-1"></i> Save
            </button>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(message))
    {
        <div class="alert @(messageIsOk ? "alert-success" : "alert-danger") py-2">@message</div>
    }

    @if (isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-success"></div>
        </div>
    }
    else if (report == null)
    {
        <div class="alert alert-info">Choose employee, report type, and period, then generate the KPI report.</div>
    }
    else
    {
        <div class="table-responsive shadow-sm">
            <table class="kpi-report-grid">
                <thead>
                    <tr>
                        <th colspan="4" class="text-center">@report.EmployeeName @report.TemplateCode @report.ReportType KPI Report Form</th>
                    </tr>
                    <tr>
                        <th>Reporting Details</th>
                        <th>Metric</th>
                        <th>Input / Final Value</th>
                        <th>CRM Evidence / Guidance</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td class="kpi-code">Employee Name</td>
                        <td class="kpi-metric">@report.EmployeeName</td>
                        <td class="kpi-input">
                            <div><strong>Type:</strong> @report.ReportType</div>
                            <div><strong>Template:</strong> @report.TemplateCode</div>
                            @if (report.WeekNumber.HasValue)
                            {
                                <div><strong>Week No.:</strong> @report.WeekNumber</div>
                            }
                            <div><strong>Period:</strong> @report.PeriodLabel</div>
                        </td>
                        <td class="kpi-auto">
                            @if (report.LastSavedAt.HasValue)
                            {
                                <span>Last saved @report.LastSavedAt.Value.ToLocalTime().ToString("dd MMM yyyy HH:mm")</span>
                            }
                            else
                            {
                                <span>New report generated from CRM data.</span>
                            }
                        </td>
                    </tr>

                    <tr>
                        <th colspan="4">KPI Inputs</th>
                    </tr>

                    @foreach (var line in report.Lines.OrderBy(l => l.SortOrder))
                    {
                        <tr>
                            <td class="kpi-code">@line.Code</td>
                            <td class="kpi-metric">@line.MetricName</td>
                            <td class="kpi-input">
                                @if (line.IsManualInput)
                                {
                                    <textarea class="form-control border-warning" @bind="line.ManualValueText" placeholder="@ManualPlaceholder(line)"></textarea>
                                    @if (!string.IsNullOrWhiteSpace(line.AutoValueText))
                                    {
                                        <div class="small text-muted mt-2">
                                            Auto suggestion: @line.AutoValueText
                                        </div>
                                    }
                                }
                                else
                                {
                                    <div class="fw-bold">@line.AutoValueText</div>
                                }
                            </td>
                            <td class="kpi-auto">
                                <div class="fw-bold">@line.Guidance</div>
                                @if (!string.IsNullOrWhiteSpace(line.EvidenceText))
                                {
                                    <div class="small mt-2">@line.EvidenceText</div>
                                }
                            </td>
                        </tr>
                    }

                    <tr>
                        <th colspan="4">Summary</th>
                    </tr>
                    <tr class="kpi-summary">
                        <td class="kpi-code">Main Achievements</td>
                        <td colspan="3" class="kpi-input">
                            <textarea class="form-control" @bind="report.MainAchievements"></textarea>
                        </td>
                    </tr>
                    <tr class="kpi-summary">
                        <td class="kpi-code">Additional Comments</td>
                        <td colspan="3" class="kpi-input">
                            <textarea class="form-control" @bind="report.AdditionalComments"></textarea>
                        </td>
                    </tr>
                    <tr>
                        <td class="kpi-code">Manager Review</td>
                        <td colspan="3" class="kpi-input">
                            <input class="form-control" @bind="report.ManagerReview" />
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    private List<ApplicationUser> users = new();
    private KpiReportDto? report;
    private string selectedEmployeeId = "";
    private string currentUserId = "";
    private string templateCode = "ELV 01";
    private string reportType = "Weekly";
    private DateTime periodAnchor = DateTime.Today;
    private string selectedPeriodValue = "";
    private List<PeriodOption> periodOptions = new();
    private bool isLoading = true;
    private string message = "";
    private bool messageIsOk = true;

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthStateProvider.GetAuthenticationStateAsync();
        currentUserId = UserManager.GetUserId(auth.User) ?? "";

        users = await KpiReportService.GetKpiUsersAsync();
        selectedEmployeeId = users.FirstOrDefault()?.Id ?? currentUserId;
        RefreshPeriodOptions();

        await LoadReportAsync();
    }

    private void RefreshPeriodOptions()
    {
        periodOptions.Clear();

        if (reportType == "Monthly")
        {
            var month = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1);
            for (var i = 0; i < 24; i++)
            {
                var date = month.AddMonths(-i);
                periodOptions.Add(new PeriodOption(date.ToString("yyyy-MM-dd"), date.ToString("MMMM yyyy")));
            }
        }
        else
        {
            var today = DateTime.Today;
            var mondayOffset = ((int)today.DayOfWeek - (int)DayOfWeek.Monday + 7) % 7;
            var monday = today.AddDays(-mondayOffset);

            for (var i = 0; i < 52; i++)
            {
                var start = monday.AddDays(-7 * i);
                var week = System.Globalization.ISOWeek.GetWeekOfYear(start);
                periodOptions.Add(new PeriodOption(
                    start.ToString("yyyy-MM-dd"),
                    $"Week {week}: {start:dd MMM} - {start.AddDays(6):dd MMM yyyy}"));
            }
        }

        selectedPeriodValue = periodOptions.FirstOrDefault()?.Value ?? "";
        if (DateTime.TryParse(selectedPeriodValue, out var selected))
            periodAnchor = selected;
    }

    private void SelectPeriod(ChangeEventArgs args)
    {
        selectedPeriodValue = args.Value?.ToString() ?? "custom";
        if (DateTime.TryParse(selectedPeriodValue, out var selected))
            periodAnchor = selected;
    }

    private async Task LoadReportAsync()
    {
        if (string.IsNullOrWhiteSpace(selectedEmployeeId))
        {
            isLoading = false;
            return;
        }

        isLoading = true;
        message = "";

        try
        {
            report = await KpiReportService.GetReportAsync(selectedEmployeeId, templateCode, reportType, periodAnchor);
        }
        catch (Exception ex)
        {
            report = null;
            messageIsOk = false;
            message = "KPI generation failed: " + ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task SaveReportAsync()
    {
        if (report == null)
            return;

        isLoading = true;
        message = "";

        try
        {
            await KpiReportService.SaveReportAsync(report, currentUserId);
            report = await KpiReportService.GetReportAsync(report.EmployeeId, report.TemplateCode, report.ReportType, report.PeriodStart);
            messageIsOk = true;
            message = "KPI report saved.";
        }
        catch (Exception ex)
        {
            messageIsOk = false;
            message = "Save failed: " + ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private static string DisplayName(ApplicationUser user)
    {
        return string.IsNullOrWhiteSpace(user.FullName) ? user.Email ?? user.UserName ?? "Unknown User" : user.FullName;
    }

    private static string ManualPlaceholder(KpiReportLineDto line)
    {
        if (line.MetricName.Contains("GP", StringComparison.OrdinalIgnoreCase))
            return "Enter GP / sales figure or progress note";

        if (line.MetricName.Contains("Margin", StringComparison.OrdinalIgnoreCase))
            return "Enter net margin %";

        if (line.MetricName.Contains("Collection", StringComparison.OrdinalIgnoreCase))
            return "Enter collection status / % collected";

        if (line.MetricName.Contains("Escalation", StringComparison.OrdinalIgnoreCase))
            return "Enter NO, or list support needed";

        return "Add brief KPI update";
    }

    private sealed record PeriodOption(string Value, string Label);
}
